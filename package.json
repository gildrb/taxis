{
  "name": "pattern-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "dev:tailnet": "PATTERN_LAB_HOSTNAME=$(tailscale ip -4) PORT=5173 bun --hot src/server.ts",
    "build": "bun run scripts/build.ts",
    "preview": "NODE_ENV=production bun src/server.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/pattern.test.ts tests/server-path.test.ts tests/server-start.test.ts",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "description": "Deterministic image-to-pattern texture editor"
}
