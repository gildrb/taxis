{
  "name": "taxis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --hot src/server.ts",
    "dev:local": "NODE_ENV=development bun --hot src/server.ts",
    "dev:tailnet": "poros bun run dev",
    "build": "bun run scripts/build.ts",
    "build:native": "bun run scripts/build-native.ts",
    "check:native": "bun run scripts/build-native.ts --check",
    "preview": "NODE_ENV=production bun src/server.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/*.test.ts",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "mediabunny": "^1.55.7",
    "motion": "13.2.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "description": "Deterministic image-to-pattern texture editor",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  }
}
